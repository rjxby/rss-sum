# Loaded by go run main.go. Exported variables take precedence.
RUN_MIGRATION=true
HTTP_SERVER_ENABLED=true
RSS_WORKER_ENABLED=true
HTTP_ADDR=:8080
DATABASE_PATH=data/rss-sum.sqlite
FEEDS=https://go.dev/blog/feed.atom
FEED_ITEMS_LIMIT=3
WORKER_TIMEOUT_IN_SECONDS=1800
WORKER_INTERVAL_IN_SECONDS=3600
LLM_SYSTEM_PROMPT_FILE=

# Start the proxy in its repository with make stack-run.
LLM_PROVIDER=gen-proxy
GEN_PROXY_BASE_URL=https://localhost:7001
GEN_PROXY_MODEL=runtime-model
# Match PUBLIC_API_KEY or ApiKeys__Keys__0 in gen-proxy's .env.
GEN_PROXY_API_KEY=dev-local-key
GEN_PROXY_TIMEOUT_IN_SECONDS=300

# Used only with LLM_PROVIDER=ollama.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_SCHEME=http
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_IN_SECONDS=60
